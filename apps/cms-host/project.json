{
  "name": "cms-host",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/cms-host/src",
  "tags": ["type:app", "scope:cms"],
  "implicitDependencies": ["angular-app", "banner"],
  "targets": {
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx nx build banner --configuration=development --watch",
          "npx nx build angular-app --configuration=development --watch",
          "node --watch apps/cms-host/src/server.mjs"
        ],
        "parallel": true
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["banner"],
          "target": "build"
        },
        {
          "projects": ["angular-app"],
          "target": "build"
        }
      ],
      "options": {
        "command": "node apps/cms-host/src/server.mjs"
      }
    }
  }
}
